rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'fldudonpit@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidCompetitionId(id) {
      return id in [
        'singing-contest',
        'christmas-card',
        'speech',
        'drawing-painting',
        'english-quiz',
        'cover-dance'
      ];
    }

    function isValidDivisionForCompetition(competitionId, division) {
      return (
        (competitionId in ['drawing-painting', 'cover-dance'] && division == 'open') ||
        (competitionId in ['singing-contest', 'christmas-card', 'speech', 'english-quiz'] &&
          division in ['junior', 'senior'])
      );
    }

    function isValidGrade(grade) {
      return grade in ['ม.1', 'ม.2', 'ม.3', 'ม.4', 'ม.5', 'ม.6'];
    }

    function isValidTeamMembersList(listVal) {
      return listVal is list
        && listVal.size() <= 10
        && (
          listVal.size() == 0 ||
          (listVal[0] is map && listVal[0].keys().hasOnly(['name', 'gradeClass']) &&
           listVal[0].name is string && listVal[0].name.size() <= 120 &&
           listVal[0].gradeClass is string && listVal[0].gradeClass.size() <= 30)
        );
    }

    function isValidRegistration(data) {
      return data.keys().hasAll([
          'ownerUid',
          'raceNumber',
          'competitionId',
          'division',
          'studentName',
          'studentId',
          'gradeLevel',
          'classroom',
          'contactInfo',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'raceNumber',
          'competitionId',
          'division',
          'studentName',
          'englishFullName',
          'studentId',
          'gradeLevel',
          'classroom',
          'contactInfo',
          'teamName',
          'teamMembersList',
          'teamMembers',
          'submissionTitle',
          'submissionUrl',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.raceNumber is string && data.raceNumber.size() >= 4 && data.raceNumber.size() <= 24 && data.raceNumber.matches('^#UP-[A-Z0-9\\-]+$')
        && isValidCompetitionId(data.competitionId)
        && isValidDivisionForCompetition(data.competitionId, data.division)
        && data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 150
        && (!('englishFullName' in data) || (data.englishFullName is string && data.englishFullName.size() <= 150))
        && data.studentId is string && data.studentId.size() >= 4 && data.studentId.size() <= 8 && data.studentId.matches('^[0-9]{4,8}$')
        && isValidGrade(data.gradeLevel)
        && data.classroom is string && data.classroom.size() >= 1 && data.classroom.size() <= 20
        && data.contactInfo is string && data.contactInfo.size() >= 5 && data.contactInfo.size() <= 60
        && (!('teamName' in data) || (data.teamName is string && data.teamName.size() <= 100))
        && (!('teamMembersList' in data) || isValidTeamMembersList(data.teamMembersList))
        && (!('teamMembers' in data) || (data.teamMembers is string && data.teamMembers.size() <= 2000))
        && (!('submissionTitle' in data) || (data.submissionTitle is string && data.submissionTitle.size() <= 200))
        && (!('submissionUrl' in data) || (data.submissionUrl is string && data.submissionUrl.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicEntry(data) {
      return data.keys().hasAll([
          'ownerUid',
          'raceNumber',
          'competitionId',
          'division',
          'displayName',
          'gradeLevel',
          'classroom',
          'isPublic',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'raceNumber',
          'competitionId',
          'division',
          'displayName',
          'gradeLevel',
          'classroom',
          'teamName',
          'teamMemberCount',
          'isPublic',
          'createdAt'
        ])
        && isValidId(data.ownerUid)
        && data.raceNumber is string && data.raceNumber.size() >= 4 && data.raceNumber.size() <= 24 && data.raceNumber.matches('^#UP-[A-Z0-9\\-]+$')
        && isValidCompetitionId(data.competitionId)
        && isValidDivisionForCompetition(data.competitionId, data.division)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 150
        && isValidGrade(data.gradeLevel)
        && data.classroom is string && data.classroom.size() >= 1 && data.classroom.size() <= 20
        && (!('teamName' in data) || (data.teamName is string && data.teamName.size() <= 100))
        && (!('teamMemberCount' in data) || (data.teamMemberCount is int && data.teamMemberCount >= 1 && data.teamMemberCount <= 10))
        && data.isPublic == true
        && data.createdAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'addedByUid', 'createdAt'])
        && data.keys().hasOnly(['email', 'addedByUid', 'createdAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 150
        && isValidId(data.addedByUid)
        && data.createdAt is timestamp;
    }

    // Private full registrations (PII isolated to owner or admin; zero DB reads in allow list)
    match /registrations/{registrationId} {
      allow get: if isValidId(registrationId) && isVerifiedUser() && (
        existing().ownerUid == request.auth.uid || isAdmin()
      );
      allow list: if isVerifiedUser() && (
        isBootstrappedAdmin() || resource.data.ownerUid == request.auth.uid
      );
      allow create: if isVerifiedUser()
        && isValidId(registrationId)
        && isValidRegistration(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/public_entries/$(registrationId));
      allow update: if isVerifiedUser()
        && isValidId(registrationId)
        && isValidRegistration(incoming())
        && (
          isAdmin() ||
          (existing().ownerUid == request.auth.uid &&
           incoming().ownerUid == existing().ownerUid &&
           incoming().createdAt == existing().createdAt &&
           incoming().updatedAt == request.time &&
           incoming().diff(existing()).affectedKeys().hasOnly([
             'submissionTitle',
             'submissionUrl',
             'updatedAt'
           ]))
        );
      allow delete: if isVerifiedUser()
        && isValidId(registrationId)
        && (existing().ownerUid == request.auth.uid || isAdmin())
        && !existsAfter(/databases/$(database)/documents/public_entries/$(registrationId));
    }

    // Public non-PII Starting Grid entries
    match /public_entries/{entryId} {
      allow get: if isValidId(entryId) && resource.data.isPublic == true;
      allow list: if resource.data.isPublic == true;
      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && isValidPublicEntry(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/registrations/$(entryId));
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(entryId)
        && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Committee Admins
    match /admins/{adminUid} {
      allow get: if isVerifiedUser() && isValidId(adminUid) && (
        request.auth.uid == adminUid || isBootstrappedAdmin()
      );
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin()
        && isValidId(adminUid)
        && isValidAdminUser(incoming())
        && incoming().addedByUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isBootstrappedAdmin() && isValidId(adminUid);
    }
  }
}
